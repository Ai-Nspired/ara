{
  "name": "ara",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2025-07-01",
  // global_fetch_strictly_public: ARA reaches orproxy on the same
  // workers.dev zone, and without this flag the edge refuses that subrequest
  // with error 1042 before it leaves Cloudflare. The flag makes global fetch
  // resolve every hostname the way an outside client would, which is what a
  // call to the proxy actually needs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "browser": {
    "binding": "BROWSER"
  },
  "services": [
    {
      "binding": "CODS",
      "service": "cods",
      "environment": "production"
    },
    {
      "binding": "MIND",
      "service": "mind",
      "environment": "production"
    },
    {
      // Pulse, while the Worker is still named ambient. Binding first so the
      // rename does not have to touch this line again.
      "binding": "PULSE",
      "service": "ambient",
      "environment": "production"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "248766b1-d102-4e9e-a228-a19281ed5fe6"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "4a9bfbffb4d440cba86badc508e2045a"
    },
    {
      "binding": "MASTER_TRUTHS",
      "id": "904eff3af4c14f06964e4f651cce9573"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "speakeasy-files"
    }
  ]
}
